#!/bin/sh
set -e
case "$1" in
    configure)
        if ! getent passwd sunnyfit-ble-cli >/dev/null; then
            adduser --system --group --home /var/lib/sunnyfit-ble-cli --no-create-home --quiet sunnyfit-ble-cli
        fi
        install -d -o sunnyfit-ble-cli -g sunnyfit-ble-cli -m 0700 /var/lib/sunnyfit-ble-cli
        if [ ! -e /var/log/sunnyfit-ble-cli.log ]; then
            install -o sunnyfit-ble-cli -g sunnyfit-ble-cli -m 0640 /dev/null /var/log/sunnyfit-ble-cli.log
        fi
        if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
        # Deliberately do not enable or start the system service on installation.
        ;;
esac
exit 0
