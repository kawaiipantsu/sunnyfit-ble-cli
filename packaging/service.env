# Read by systemd as root. Keep this file root:root with mode 0600.
# Values here override /etc/sunnyfit-ble-cli/config.toml.
# SUNNY_DEVICE=AA:BB:CC:DD:EE:FF
# SUNNY_ADAPTER=hci1
# SUNNY_SINKS=mysql,redis,sqlite
# SUNNY_MYSQL_URL=mysql://user:URL_ENCODED_PASSWORD@db.example:3306/workouts
# SUNNY_REDIS_URL=redis://redis.example:6379/0
# SUNNY_HEART_RATE_DEVICE=AA:BB:CC:DD:EE:00
# SUNNY_HEART_RATE_ADAPTER=hci1
# SUNNY_RAW_CHANNEL=sunnyfit:raw
# SUNNY_METRICS_CHANNEL=sunnyfit:metrics
# SUNNY_STATUS_CHANNEL=sunnyfit:status
# SUNNY_WORKOUT_CHANNEL=sunnyfit:workouts
